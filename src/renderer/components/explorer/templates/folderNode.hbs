<li
  class="folder {{#unless isOpen}}collapsed{{/unless}} {{#unless parentMeta}}folder-root {{rootClass}}{{/unless}} {{#if meta.advanced}}advanced-item{{/if}}"
  event-click="folder:toggle"
  data-path="{{relativePath}}"
  data-status="{{#if isOpen}}open{{else}}collapsed{{/if}}"
>
  <span class="folder-name">
    <i class="fa-solid fa-chevron-right tree-arrow"></i>
    <i
      class="fa-solid {{#if isOpen}}fa-folder-open{{else}}fa-folder{{/if}} icon-folder"
    ></i>
    <span class="folder-title">{{meta.title}}</span>
  </span>
</li>